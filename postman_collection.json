{
  "info": {
    "name": "CST3144_API_Test",
    "description": "API collection for Course Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "RENDER_URL",
      "value": "https://famy-backend.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/",
          "host": ["{{RENDER_URL}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Get All Lessons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/lessons",
          "host": ["{{RENDER_URL}}"],
          "path": ["lessons"]
        }
      }
    },
    {
      "name": "Get Lesson by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/lessons/1",
          "host": ["{{RENDER_URL}}"],
          "path": ["lessons", "1"]
        }
      }
    },
    {
      "name": "Update Lesson",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"spaces\": 8,\n  \"price\": 35\n}"
        },
        "url": {
          "raw": "{{RENDER_URL}}/lessons/1",
          "host": ["{{RENDER_URL}}"],
          "path": ["lessons", "1"]
        }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"1234567890\",\n  \"lessonIDs\": [\"1\", \"3\", \"5\"],\n  \"numSpaces\": [2, 1, 3]\n}"
        },
        "url": {
          "raw": "{{RENDER_URL}}/orders",
          "host": ["{{RENDER_URL}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/orders",
          "host": ["{{RENDER_URL}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "Search Lessons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/search?q=math",
          "host": ["{{RENDER_URL}}"],
          "path": ["search"],
          "query": [
            {
              "key": "q",
              "value": "math"
            }
          ]
        }
      }
    },
    {
      "name": "Search by Location",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/search?q=london",
          "host": ["{{RENDER_URL}}"],
          "path": ["search"],
          "query": [
            {
              "key": "q",
              "value": "london"
            }
          ]
        }
      }
    },
    {
      "name": "Search by Price",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/search?q=30",
          "host": ["{{RENDER_URL}}"],
          "path": ["search"],
          "query": [
            {
              "key": "q",
              "value": "30"
            }
          ]
        }
      }
    },
    {
      "name": "Get Image",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{RENDER_URL}}/images/mathematics.jpg",
          "host": ["{{RENDER_URL}}"],
          "path": ["images", "mathematics.jpg"]
        }
      }
    }
  ]
}
